# Supabase — copy to .env.local and fill in from your project settings.
# Both key naming schemes are accepted; use whichever your dashboard shows.

# Public (safe to expose to the browser). Also allow-lists the storage host
# used for uploaded screenshots in next.config.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# or the legacy name:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, privileged — used by `npm run seed` to load the defaults.
# Never expose this to the browser and never commit it.
SUPABASE_SECRET_KEY=
# or the legacy name:
# SUPABASE_SERVICE_ROLE_KEY=

# Note: the owner allowlist is NOT an env var. Owners are stored in the
# Supabase `admin_users` table — see supabase/schema.sql and the README.

# ─────────────────────────────────────────────────────────────
# Contact form (Resend — https://resend.com)
# Without RESEND_API_KEY the form returns "not configured" and sends nothing.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Where enquiries are delivered. Falls back to the profile email if unset.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "HelsaGrace <hello@yourdomain.com>".
# Defaults to Resend's test sender (onboarding@resend.dev), which can only
# deliver to the Resend account owner.
CONTACT_FROM_EMAIL=

